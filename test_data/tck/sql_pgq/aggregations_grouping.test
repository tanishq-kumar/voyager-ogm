# name: test/sql/sql_pgq/aggregations_grouping.test
# description: ISO SQL:2023 PGQ & DuckPGQ Aggregation and Grouping in GRAPH_TABLE
# group: [pgq]

statement ok
CREATE TABLE Employee (id BIGINT PRIMARY KEY, name VARCHAR, department VARCHAR, salary DOUBLE);

statement ok
CREATE TABLE projects (emp_id BIGINT, project_name VARCHAR, budget DOUBLE);

statement ok
