statement ok
INSERT INTO projects VALUES
  (1, 'Project Alpha', 500000.0),
  (1, 'Project Beta', 300000.0),
  (2, 'Project Alpha', 500000.0),
  (3, 'Growth 2026', 150000.0),
  (4, 'Rebrand', 200000.0);

statement ok
CREATE PROPERTY GRAPH corp_pg
  VERTEX TABLES (
    Employee KEY (id) LABEL Employee PROPERTIES (id, name, department, salary)
  )
  EDGE TABLES (
    projects
      SOURCE KEY (emp_id) REFERENCES Employee (id)
      DESTINATION KEY (emp_id) REFERENCES Employee (id)
      LABEL works_on
      PROPERTIES (project_name, budget)
  );

# Aggregations by Department
query TRR
SELECT 
  gt.dept,
  COUNT(gt.emp_id) AS emp_count,
  AVG(gt.salary) AS avg_salary
FROM GRAPH_TABLE (
  corp_pg
  MATCH (e:Employee)
  COLUMNS (
    e.department AS dept,
    e.id AS emp_id,
    e.salary AS salary
  )
) AS gt
GROUP BY gt.dept
ORDER BY emp_count DESC, gt.dept ASC;
