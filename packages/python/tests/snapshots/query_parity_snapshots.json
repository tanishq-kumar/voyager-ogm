      "status": "ok"
    },
    "sql_pgq": {
      "execution_mode": "normal",
      "parameters": {},
      "statement": "SELECT * FROM GRAPH_TABLE (g MATCH (p IS Person) -[w IS WORKS_AT]-> (c IS Company) COLUMNS (c.name AS company, count(p) AS total, avg(p.age) AS avg_age, min(p.age) AS min_age, max(p.age) AS max_age))",
